# Public runtime configuration. Do not place production secrets in this file.
NODE_ENV=development
API_PORT=3000
API_CORS_ORIGINS=http://localhost:3001,http://localhost:3002
LAUNCH_COUNTRY_CODE=ET
LAUNCH_CITY_SLUG=launch-city
DEFAULT_CURRENCY=ETB
DATABASE_URL=postgresql://delivery_app:delivery_app@localhost:5432/delivery_app
REDIS_URL=redis://localhost:6379
AUTH_TOKEN_SECRET=replace-with-a-long-random-development-secret

# Pricing, quote, session and dispatch defaults (integer minor units).
DELIVERY_FEE_MINOR=5000
SERVICE_FEE_MINOR=300
QUOTE_VALIDITY_SECONDS=900
ACCESS_TOKEN_LIFETIME_SECONDS=900
REFRESH_TOKEN_LIFETIME_SECONDS=2592000
COURIER_OFFER_TIMEOUT_SECONDS=45
DISPATCH_RADIUS_METERS=8000
MAX_PENDING_OFFERS_PER_COURIER=3
DELIVERY_PROOF_OTP_REQUIRED=true
TAX_RATE_BPS=0

# Public base URL used for provider callbacks and sandbox checkout links.
PUBLIC_API_BASE_URL=http://localhost:3000

# Provider integrations remain intentionally disabled until credentials and
# commercial/regulatory approval are complete.
PAYMENTS_PROVIDER=disabled
OTP_PROVIDER=disabled
MAPS_PROVIDER=disabled

# Push notifications use Firebase Cloud Messaging.
PUSH_PROVIDER=disabled
# Raw Firebase service-account JSON, or set GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Sandbox payments are development/test only. Set PAYMENTS_PROVIDER to chapa,
# stripe, or telebirr and provide the matching secrets. Stripe restricted test
# keys (rk_test_) work for checkout and refunds. Telebirr requires the public key
# issued by Ethio Telecom to verify signed payment notifications.
# PAYMENT_WEBHOOK_SECRET=
# CHAPA_SECRET_KEY=
# CHAPA_WEBHOOK_SECRET=
# CHAPA_BASE_URL=https://api.chapa.global
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# TELEBIRR_ENVIRONMENT=test
# TELEBIRR_FABRIC_APP_ID=
# TELEBIRR_APP_SECRET=
# TELEBIRR_MERCHANT_APP_ID=
# TELEBIRR_MERCHANT_CODE=
# TELEBIRR_PRIVATE_KEY=
# TELEBIRR_PUBLIC_KEY=
# TELEBIRR_NOTIFY_URL=
# TELEBIRR_REDIRECT_URL=
# PAYMENT_RETURN_URL=
# PAYMENT_CANCEL_URL=

# Development only: use a six-digit value here only while NODE_ENV=development.
# Never set OTP_PROVIDER=development or commit OTP_DEVELOPMENT_CODE in staging/production.
# OTP_DEVELOPMENT_CODE=123456
