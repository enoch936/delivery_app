{
  "name": "@delivery-app/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "tsx --test test/auth.service.test.ts test/discovery.service.test.ts test/runtime-config.test.ts test/payments.telebirr.test.ts",
    "test:integration": "tsc -p tsconfig.test.json && node --test --test-concurrency=1 \"dist-test/test/*.integration.test.js\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@delivery-app/domain": "0.1.0",
    "@fastify/static": "10.1.6",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-fastify": "12.2.0",
    "@nestjs/swagger": "12.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "16.6.1",
    "fastify": "5.12.7",
    "firebase-admin": "14.5.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "stripe": "23.0.1",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.1"
  }
}
